{
  "name": "oarkit-mcp",
  "version": "0.2.0",
  "description": "Oarkit's portfolio as an MCP server: ask Claude who we are, what we've built, what we charge, and whether we're free. Fork it and edit one JSON file to make it yours.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "oarkit-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "profile.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "portfolio",
    "resume",
    "cv",
    "freelance",
    "hiring",
    "claude",
    "ai-agent",
    "template"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test test/unit.test.mjs",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "author": "Franckelson Duvelson <hello@oarkit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franckyo/oarkit-mcp.git"
  },
  "homepage": "https://github.com/franckyo/oarkit-mcp#readme",
  "bugs": {
    "url": "https://github.com/franckyo/oarkit-mcp/issues"
  }
}
